{
  "name": "personal-manual-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint app lib types --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply personal-manual-builder-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-manual-builder-db --remote",
    "db:seed-admin:local": "node scripts/seed-admin.mjs",
    "db:seed-admin:remote": "node scripts/seed-admin.mjs --remote"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.17.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.123.0"
  }
}
